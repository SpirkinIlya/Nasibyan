  {# ── Colors ─────────────────────────────────────────────────────────── #}
  <section class="ui-section">
    <p class="ui-section__title">Colors</p>

    <div class="ui-row">
      <div class="ui-swatch">
        <div class="ui-swatch__color" style="background-color: var(--color-dark);"></div>
        <span class="ui-swatch__name">Dark</span>
        <span class="ui-swatch__hex">#0e0d0b</span>
      </div>
      <div class="ui-swatch">
        <div class="ui-swatch__color" style="background-color: var(--color-white);"></div>
        <span class="ui-swatch__name">White</span>
        <span class="ui-swatch__hex">#ffffff</span>
      </div>
      <div class="ui-swatch">
        <div class="ui-swatch__color" style="background-color: var(--color-accent-sand);"></div>
        <span class="ui-swatch__name">Accent Sand</span>
        <span class="ui-swatch__hex">#c59857</span>
      </div>
      <div class="ui-swatch">
        <div class="ui-swatch__color" style="background-color: var(--color-accent-brown);"></div>
        <span class="ui-swatch__name">Accent Brown</span>
        <span class="ui-swatch__hex">#5a4025</span>
      </div>
      <div class="ui-swatch">
        <div class="ui-swatch__color" style="background-color: var(--color-accent-pale);"></div>
        <span class="ui-swatch__name">Accent Pale</span>
        <span class="ui-swatch__hex">#dabdab</span>
      </div>
      <div class="ui-swatch">
        <div class="ui-swatch__color" style="background-color: var(--color-accent-red);"></div>
        <span class="ui-swatch__name">Accent Red</span>
        <span class="ui-swatch__hex">#9a1710</span>
      </div>
    </div>
  </section>

  {# ── Button ─────────────────────────────────────────────────────────── #}
  <section class="ui-section">
    <p class="ui-section__title">Button</p>

    <div class="ui-row">
      {{button({text:"Button primary", theme: "primary"})}}
      {{button({text:"Button secondary", theme: "secondary"})}}
      {{button({text:"Button disabled", theme: "primary", disabled: true})}}
      {{button({text:"Button disabled", theme: "secondary", disabled: true})}}
      {{button({text:"Button tertiary", theme: "tertiary"})}}
    </div>
  </section>

  {# ── Button as link ─────────────────────────────────────────────────── #}
  <section class="ui-section">
    <p class="ui-section__title">Button — type link</p>

    <div class="ui-row">
      {{ button({ text: "Link Primary", type: "link", href: "/", theme: "primary" }) }}
      {{ button({ text: "Link Secondary", type: "link", href: "/", theme: "secondary" }) }}
    </div>
  </section>

</div>
{% endblock %}