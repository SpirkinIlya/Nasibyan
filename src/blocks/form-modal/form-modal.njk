{% from "blocks/form/form.njk" import form %}
{% from "blocks/form-field/form-field.njk" import formField %}
{% from "blocks/select/select.njk" import select %}
{% from "blocks/input/input.njk" import input %}
{% from "blocks/textarea/textarea.njk" import textarea %}
{% from "blocks/button/button.njk" import button %}

{% macro formModal() %}
<div class="form-modal" data-js="form-modal" role="dialog" aria-modal="true" aria-labelledby="form-modal-title" hidden>
  <div class="form-modal__overlay" data-js="form-modal-overlay"></div>
  <div class="form-modal__content">

    <div class="form-modal__header">
      <h2 class="form-modal__title" id="form-modal-title" data-js="form-modal-title">Записаться на курс</h2>
      <button class="form-modal__close" data-js="form-modal-close" type="button" aria-label="Закрыть">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <line x1="4" y1="4" x2="20" y2="20" stroke="black" stroke-width="2" stroke-linecap="round" />
          <line x1="20" y1="4" x2="4" y2="20" stroke="black" stroke-width="2" stroke-linecap="round" />
        </svg>
      </button>
    </div>

    {% call form({ action: "#", class: "form-modal__form", novalidate: true }) %}
    <div class="form__fields">
      {% call formField({ name: "course" }) %}
      {{ select({ name: "course-modal", placeholder: "Выберите курс или тренинг", options: [
      { value: "1", text: "Базовый курс" },
      { value: "2", text: "Продвинутый тренинг" },
      { value: "3", text: "Мистика и психология" }
      ] }) }}
      {% endcall %}
      {% call formField({ label: "ФИО", name: "name-modal" }) %}
      {{ input({ name: "name-modal", placeholder: "Введите Ваше имя" }) }}
      {% endcall %}
      {% call formField({ label: "Email", name: "email-modal" }) %}
      {{ input({ name: "email-modal", type: "email" }) }}
      {% endcall %}
      {% call formField({ label: "Телефон", name: "phone-modal" }) %}
      {{ input({ name: "phone-modal", type: "tel", inputmode: "tel" }) }}
      {% endcall %}
      {% call formField({ label: "Вопрос", name: "question-modal" }) %}
      {{ textarea({ name: "question-modal" }) }}
      {% endcall %}
    </div>
    <div class="form__footer">
      <div class="form__consents">
        <label class="form__consent">
          <input class="form__consent-checkbox" type="checkbox" name="consent_privacy" required>
          <span class="form__consent-text">Я ознакомился с <a class="form__consent-link"
              href="/usloviya-obrabotki-personalnyix-dannyix">Политикой конфиденциальности</a></span>
        </label>
        <label class="form__consent">
          <input class="form__consent-checkbox" type="checkbox" name="consent_data" required>
          <span class="form__consent-text">Я даю согласие на <a class="form__consent-link" href="/agree">обработку
              персональных данных</a></span>
        </label>
      </div>
      {{ button({ text: "Отправить заявку", theme: "primary", width: "full" }) }}
    </div>
    {% endcall %}

  </div>
</div>
{% endmacro %}