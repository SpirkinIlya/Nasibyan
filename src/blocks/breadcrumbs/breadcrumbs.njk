{% macro breadcrumbs(items) %}
{% if items and items.length %}
<nav class="breadcrumbs container" aria-label="Хлебные крошки">
    <ol class="breadcrumbs__list" itemscope itemtype="https://schema.org/BreadcrumbList">
        {% for item in items %}
        <li class="breadcrumbs__item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
            {% if not loop.last %}
            <a class="breadcrumbs__link" href="{{ item.url }}" itemprop="item">
                <span itemprop="name">{{ item.name }}</span>
            </a>
            {% else %}
            <span class="breadcrumbs__current" itemprop="name" aria-current="page">
                {{ item.name }}
            </span>

            {% if item.url %}
            <meta itemprop="item" content="{{ item.url }}">
            {% endif %}
            {% endif %}

            <meta itemprop="position" content="{{ loop.index }}">

            {% if not loop.last %}
            <span class="breadcrumbs__separator" aria-hidden="true">
                <svg width="15" height="15" fill="none">
                    <use href="/images/sprite/sprite.svg#icon-separator"></use>
                </svg>
            </span>
            {% endif %}
        </li>
        {% endfor %}
    </ol>
</nav>
{% endif %}
{% endmacro %}