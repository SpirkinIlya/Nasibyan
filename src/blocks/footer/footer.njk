{% from "blocks/logo/logo.njk" import logo %}
{% from "blocks/button/button.njk" import button %}
{% from "blocks/bottom-nav/bottom-nav.njk" import bottomNav %}

{% set footerMenu = [
{
title: "О Сергее Насибяне",
url: 'about/' | url
},
{
title: "Расписание",
url: 'schedule/' | url
},
{
title: "Тренинги",
url: 'trainings/' | url
},
{
title: "Мистика",
url: 'mystery/' | url
},
{
title: "Психология",
url: 'psychology/' | url
},
{
title: "Философия",
url: 'philosophy/' | url
},
{
title: "Книги",
url: 'books/' | url
},
{
title: "Лекции",
url: 'lectures/' | url
},
{
title: "Статьи",
url: 'articles/' | url
},
{
title: "Вопросы и ответы",
url: 'faq/' | url
},
{
title: "Консультации",
url: 'consultations/' | url
},
{
title: "Контакты",
url: 'contacts/' | url
}
] %}

{% macro footer(data) %}
<footer class="footer">
  <div class="container footer__container">
    <div class="footer__mobile-logo">
      <div class="footer__logo">{{ logo({ base: data.base }) }}</div>
      <div class="footer__social-links footer__social-links_mobile">
        <a href="#" class="footer__social-link">
          <svg width="40" height="40">
            <use href="{{ 'images/sprite/sprite.svg#icon-telegram-circle' | url }}"></use>
          </svg>
        </a>
        <a href="#" class="footer__social-link">
          <svg width="40" height="40">
            <use href="{{ 'images/sprite/sprite.svg#icon-vk' | url }}"></use>
          </svg>
        </a>
        <a href="#" class="footer__social-link">
          <svg width="40" height="40">
            <use href="{{ 'images/sprite/sprite.svg#icon-youtube' | url }}"></use>
          </svg>
        </a>
      </div>
    </div>
    <div class="footer__col_1">
      {{button({text:"Базовый курс", theme:"tertiary", type:"link", href:'basic-course/' | url})}}
    </div>
    <div class="footer__menu">
      <ul class="footer__menu-list">
        {% for item in footerMenu %}
        <li class="footer__menu-item">
          <a class="footer__menu-link" href="{{ item.url }}">
            {{ item.title }}
          </a>
        </li>
        {% endfor %}
      </ul>
    </div>
    <div class="footer__col_2">
      <div class="footer__social-links footer__social-links_desktop">
        <a href="#" class="footer__social-link">
          <svg width="40" height="40">
            <use href="{{ 'images/sprite/sprite.svg#icon-telegram-circle' | url }}"></use>
          </svg>
        </a>
        <a href="#" class="footer__social-link">
          <svg width="40" height="40">
            <use href="{{ 'images/sprite/sprite.svg#icon-vk' | url }}"></use>
          </svg>
        </a>
        <a href="#" class="footer__social-link">
          <svg width="40" height="40">
            <use href="{{ 'images/sprite/sprite.svg#icon-youtube' | url }}"></use>
          </svg>
        </a>
      </div>
      {{button({text:"Записаться на курс", theme:"primary"})}}
    </div>
  </div>
  <div class=" container footer__copyright font_small_12R">
    <p>© 2026 | sergeinasibyan.ru</p>
    <p>Сайт разработан <a href="https://savin-seo.ru" target="_blank"
        title="Ссылка откроется в новой вкладке">savin-seo.ru</a>, 2026 </p>
  </div>
</footer>
{{ bottomNav({
items: [
{ text: "Расписание", href: "#schedule", icon: "calendar" },
{ text: "Программы", href: "#programs", icon: "ring" },
{ text: "Соцсети", href: "#social", icon: "send" }
]
}) }}
{% endmacro %}