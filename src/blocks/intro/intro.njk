{% macro intro(data) %}
<section class="intro {{data.class}}">
    <div class="intro__decor">
        <img class="image" src="{{ 'images/hero__circle.webp' | url }}" alt="">
    </div>
    <div class="container intro__container {% if data.toForm %}intro__container_big{% endif %}">
        {{ caller() }}
    </div>
    {% if data.toForm %}
    <a class="intro__to-form" aria-label="Перейти к форме записи" href="#cta">
        <svg width="32" height="54">
            <use href="{{ 'images/sprite/sprite.svg#icon-arrow' | url }}"></use>
        </svg>
    </a>
    {% endif %}
</section>
{% endmacro %}