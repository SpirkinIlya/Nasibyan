{% macro gallery(data) %}
<section class="gallery container">
    <h2 class="gallery__title">галерея</h2>
    <div class="gallery__swiper swiper">
        <div class="swiper-wrapper" id="gallery-about">

            <div class="swiper-slide">
                <a href="{{ 'images/gallery1.jpg' | url }}" class="gallery-about" data-gallery="gallery1">
                    <img src="{{ 'images/gallery1.webp' | url }}" alt="Фото 1" loading="lazy">
                </a>
            </div>

            <div class="swiper-slide">
                <a href="{{ 'images/gallery2.jpg' | url }}" class="gallery-about" data-gallery="gallery1">
                    <img src=" {{ 'images/gallery2.webp' | url }}" alt="Фото 2" loading="lazy">
                </a>
            </div>

            <div class="swiper-slide">
                <a href="{{ 'images/gallery3.jpg' | url }}" class="gallery-about" data-gallery="gallery1">
                    <img src="{{ 'images/gallery3.webp' | url }}" alt="Фото 3" loading="lazy">
                </a>
            </div>

            <div class="swiper-slide">
                <a href="{{ 'images/11.jpg' | url }}" class="gallery-about" data-gallery="gallery1">
                    <img src="{{ 'images/11.jpg' | url }}" alt="Фото 4" loading="lazy">
                </a>
            </div>

        </div>
        <div class="swiper-controls">

            <div class="button-prev"><svg width="15" height="15" fill="none">
                    <use href="{{ 'images/sprite/sprite.svg#icon-prew' | url }}"></use>
                </svg></div>
            <div class="button-next"><svg width="15" height="15" fill="none">
                    <use href="{{ 'images/sprite/sprite.svg#icon-next' | url }}"></use>
                </svg></div>
        </div>
    </div>
</section>
{% endmacro %}