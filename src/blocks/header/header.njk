{% from "blocks/logo/logo.njk" import logo %}
{% from "blocks/button/button.njk" import button %}

{% macro header(data) %}
<header class="header" data-js="header">
  <div class="container header__container">

    <div class="header__logo">
      {{ logo({ base: data.base }) }}
    </div>

    {# ── Desktop navigation ─────────────────────────────────────────────── #}
    <nav class="header__nav" aria-label="Основная навигация">
      <ul class="header__list">
        {% for item in data.navigation %}
        <li class="header__item{% if item.children %} header__item_has-dropdown{% endif %}">
          <a class="header__link" href="{{ data.base }}{{ item.href }}" {% if item.children %}aria-haspopup="true" {%
            endif %}>{{ item.text }}</a>

          {% if item.children %}
          <div class="header__dropdown" role="region">
            <ul class="header__sublist">
              {% for child in item.children %}
              <li class="header__subitem">
                <a class="header__sublink" href="{{ data.base }}{{ child.href }}">{{ child.text }}</a>
              </li>
              {% endfor %}
            </ul>
          </div>
          {% endif %}
        </li>
        {% endfor %}
      </ul>
    </nav>

    {# ── Desktop CTA button ─────────────────────────────────────────────── #}
    <div class="header__actions">
      {{ button({ theme: "secondary", text: "Записаться на курс" }) }}
    </div>

    {# ── Mobile hamburger ───────────────────────────────────────────────── #}
    <button class="header__burger" data-js="header-burger" aria-label="Открыть меню" aria-expanded="false"
      aria-controls="header-drawer" type="button">
      <svg width="40" height="40">
        <use href="/images/sprite/sprite.svg#icon-burger"></use>
      </svg>
    </button>

  </div>

  {# ── Mobile drawer ──────────────────────────────────────────────────────── #}
  <div class="header__drawer" id="header-drawer" data-js="header-drawer" aria-hidden="true">
    <button class="header__drawer-close" data-js="header-drawer-close" aria-label="Закрыть меню" type="button"><svg
        width="40" height="40">
        <use href="/images/sprite/sprite.svg#icon-close"></use>
      </svg></button>

    <nav class="header__drawer-nav" aria-label="Мобильная навигация">
      <ul class="header__drawer-list">
        {% for item in data.navigation %}
        <li class="header__drawer-item">
          <a class="header__drawer-link" href="{{ data.base }}{{ item.href }}">{{ item.text }}</a>
        </li>
        {% if item.children %}
        {% for child in item.children %}
        <li class="header__drawer-item header__drawer-item_child">
          <a class="header__drawer-link header__drawer-link_child" href="{{ data.base }}{{ child.href }}">{{ child.text
            }}</a>
        </li>
        {% endfor %}
        {% endif %}
        {% endfor %}
      </ul>
    </nav>

    <div class="header__drawer-footer">
      {{ button({ theme: "primary", text: "Записаться на курс", width: "full" }) }}
    </div>
  </div>

  {# ── Overlay ────────────────────────────────────────────────────────────── #}
  <div class="header__overlay" data-js="header-overlay" aria-hidden="true"></div>

</header>
{% endmacro %}