{% from "blocks/form/form.njk" import form %}
{% from "blocks/form-field/form-field.njk" import formField %}
{% from "blocks/select/select.njk" import select %}
{% from "blocks/input/input.njk" import input %}
{% from "blocks/textarea/textarea.njk" import textarea %}
{% from "blocks/button/button.njk" import button %}

{% macro cta(data) %}
<section class="cta {{data.modificator}}" id="cta">
    <div class="cta__container container">
        <h2 class="cta__title">{{data.title}}</h2>
        {% call form({ action: "#", class: "cta__form", novalidate: true }) %}
        <div class="form__fields">
            {% call formField({ name: "course" }) %}
            {{ select({ name: "course", placeholder: "Выберите курс или тренинг", options: [
            { value: "1", text: "Базовый курс" },
            { value: "2", text: "Продвинутый тренинг" },
            { value: "3", text: "Мистика и психология" }
            ] }) }}
            {% endcall %}
            {% call formField({ label: "ФИО", name: "name" }) %}
            {{ input({ name: "name", placeholder: "Введите Ваше имя", value: "Екатерина" }) }}
            {% endcall %}
            {% call formField({ label: "Email", name: "email" }) %}
            {{ input({ name: "email", type: "email" }) }}
            {% endcall %}
            {% call formField({ label: "Телефон", name: "phone" }) %}
            {{ input({ name: "phone", type: "tel", inputmode: "tel" }) }}
            {% endcall %}
            {% call formField({ label: "Вопрос", name: "question" }) %}
            {{ textarea({ name: "question"}) }}
            {% endcall %}
        </div>
        <div class="form__footer">
            <div class="form__consents">
                <label class="form__consent">
                    <input class="form__consent-checkbox" type="checkbox" name="consent_privacy" required>
                    <span class="form__consent-text">Я ознакомился с <a class="form__consent-link" href="/usloviya-obrabotki-personalnyix-dannyix">Политикой конфиденциальности</a></span>
                </label>
                <label class="form__consent">
                    <input class="form__consent-checkbox" type="checkbox" name="consent_data" required>
                    <span class="form__consent-text">Я даю согласие на <a class="form__consent-link" href="/agree">обработку персональных данных</a></span>
                </label>
            </div>
            {{ button({ text: "Отправить заявку", theme: "primary", width: "full" }) }}
        </div>
        {% endcall %}
    </div>
</section>
{% endmacro %}